# Editable projectspace v1. TOML encoding inside one .projectspace container; not binary FSPC.
format = "frontier.projectspace.editor"
version = 1
content_roots = ["Content"]
levels = []
catalogue = []
dependency_pins = []
required_features = []

[project]
identity = "engine-blank-template-v1"
name = "Blank Project"
template_revision = 1

[engine]
configuration_version = 1
startup_level = ""

[workspace.appearance]
format = 1
theme = 1
accent = 6
font_family = "Inter"
interface_scale = 100.0
corner_radius = 16.0
warning = 0
success = 1
info = 0
caution = 0
sizes = [32.0, 24.0, 18.0, 14.0, 12.0, 10.0]
weights = [700, 700, 500, 400, 500, 400]

[workspace.input]
format = 1
mouse_sensitivity = 50.0
custom_shortcuts = false
advanced_controls = false
invert_pitch = false
shortcuts = [
    { command = "ControlCentre", key = "Comma", control = true, alt = false, shift = false, super = false },
    { command = "Typography", key = "F", control = true, alt = true, shift = false, super = false },
    { command = "Theme", key = "T", control = true, alt = true, shift = false, super = false },
    { command = "DismissPanel", key = "Escape", control = false, alt = false, shift = false, super = false },
]

[workspace.notifications]
format = 1
frame_rate_overlay = true
preferences_applied = true
preference_errors = true
hold_seconds = 3.5

[workspace.hosting]
format = 1
allow_detached_windows = false
dockable_content_browser = false
