[submodule "ExternalPackages/tinybvh"]
	path = ExternalPackages/tinybvh
	url = https://github.com/jbikker/tinybvh.git
[submodule "ExternalPackages/ufbx"]
	path = ExternalPackages/ufbx
	url = https://github.com/ufbx/ufbx.git
[submodule "ExternalPackages/fast_obj"]
	path = ExternalPackages/fast_obj
	url = https://github.com/thisistherk/fast_obj.git
[submodule "ExternalPackages/stb"]
	path = ExternalPackages/stb
	url = https://github.com/nothings/stb.git
[submodule "ExternalPackages/jolt"]
	path = ExternalPackages/jolt
	url = https://github.com/jrouwe/JoltPhysics.git
	ignore = untracked
	shallow = true
[submodule "ExternalPackages/miniaudio"]
	path = ExternalPackages/miniaudio
	url = https://github.com/mackron/miniaudio.git
[submodule "ExternalPackages/tomlpp"]
	path = ExternalPackages/tomlpp
	url = https://github.com/marzer/tomlplusplus.git
[submodule "ExternalPackages/imgui"]
	path = ExternalPackages/imgui
	url = https://github.com/ocornut/imgui.git
	# The patches in Patches/ need the DOCKING branch: ImGuiConfigFlags_DockingEnable does not exist on master,
	#    and without it there are no dock nodes, no tab bars, and nothing for the trapezoid to be drawn on.
	#    Declared so the pin cannot drift back to master unnoticed.
	branch = docking
[submodule "ExternalPackages/glfw"]
	path = ExternalPackages/glfw
	url = https://github.com/glfw/glfw.git
[submodule "ExternalPackages/thorvg"]
	path = ExternalPackages/thorvg
	url = https://github.com/thorvg/thorvg.git
[submodule "ExternalPackages/earcut"]
	path = ExternalPackages/earcut
	url = https://github.com/mapbox/earcut.hpp.git
[submodule "ExternalPackages/cgltf"]
	path = ExternalPackages/cgltf
	url = https://github.com/jkuhlmann/cgltf.git
[submodule "ExternalPackages/clipper2"]
	path = ExternalPackages/clipper2
	url = https://github.com/AngusJohnson/Clipper2.git
