/*==========================================================================================================================================
                                                     WINDOWSAPPLICATIONVERSION.RC
==========================================================================================================================================*/
// 🧩 Identify the standalone executable in Windows file properties; version resources are not publisher signatures.

#include <winver.h>
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "@WORKSPACE_APPLICATION@\0"
            VALUE "FileVersion", "0.1.0.0\0"
            VALUE "InternalName", "@WORKSPACE_APPLICATION@\0"
            VALUE "OriginalFilename", "@WORKSPACE_APPLICATION@.exe\0"
            VALUE "ProductName", "@WORKSPACE_APPLICATION@\0"
            VALUE "ProductVersion", "0.1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
