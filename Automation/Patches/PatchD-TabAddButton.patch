+// [FRONTIER PATCH D] The addBtn's seat and poll. DockBuilderGetNode is safe on a live tree (it returns NULL
+//   for an unknown id), so the host seats the button every tick and a rebuilt column keeps it.
+void ImGui::DockNodeSetAddButton(ImGuiID node_id, bool enabled)
+{
+    if (ImGuiDockNode* node = DockBuilderGetNode(node_id))
+        node->FrontierAddButton = enabled;
+}
+
+bool ImGui::DockNodeConsumeAddRequest(ImGuiID node_id)
+{
+    if (ImGuiDockNode* node = DockBuilderGetNode(node_id))
+    {
+        const bool pressed = node->FrontierAddPressed;
+        node->FrontierAddPressed = false;
+        return pressed;
+    }
+    return false;
+}
