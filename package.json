{
  "name": "frontier-tree-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frontier – procedural tree generator producing a single manifold quad mesh with wind-ready vertex data",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
