{
  "name": "frontier-landscape-editor",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Frontier Landscape Studio \u2014 a heightmap landscape editor driven by a non-destructive layer stack, with realistic erosion simulation and satellite / splatmap texturing.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "verify": "node scripts/verify-core.mjs && node scripts/verify-ui.mjs",
    "verify:core": "node scripts/verify-core.mjs",
    "verify:ui": "node scripts/verify-ui.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^24.1.3",
    "vite": "^6.0.0"
  }
}