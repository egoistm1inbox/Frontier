# Unified diffs contain intentional single-space context lines.
Tools/Build/Patches/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof
# Native vector-variant fingerprints require stable source bytes on Windows.
EngineContent/Icons/*.svg text eol=lf
EngineContent/Icons/ThorVG/*.svg text eol=lf
Experimental/FrontierEditor/custom-icons/*.svg text eol=lf
Experimental/FrontierEditor/ui-icons/*.svg text eol=lf
EngineContent/Icons/Baked/*.rgba binary
# Preserve the reviewed upstream snapshot byte-for-byte, including its whitespace.
Experimental/FrontierEditor/vendor/slate-new-icons/App.tsx -whitespace

# Preserve imported upstream font licence bytes, including original line endings.
EngineContent/FontArchives/*/OFL.txt -whitespace
EngineContent/FontArchives/*/LICENSE.txt -whitespace
