+// [SLATE PATCH C] The geometry of a tab-bar button, in one place so the measurement and the drawing
+//   cannot drift apart. Everything is derived from the strip height and the slant figures, all of which
+//   ScaleAllSizes already multiplies -- so the button follows the artist's UI scale without a figure of
+//   its own that would have to be scaled a second time.
+//
+//   The leading gap is what clears the PRECEDING tab's slanted trailing edge. PatchB pulls every advance
+//   back by TabOverlap, so a button seated at its own bb.Min.x starts inside the tab before it. At the
+//   button's vertical centre that tab's slant stands at (its Max.x - slant/2), so the disc must begin
+//   beyond that point: overlap - slant/2, plus a pad.
+struct SlateButtonMetric
+{
+    float Across;    // the strip's usable height
+    float Diameter;  // the disc
+    float Lead;      // gap from bb.Min.x to the disc's leading edge
+    float Advance;   // the whole width the layout reserves
+};
+
+// [SLATE PATCH C] The strip a tab-bar button is sized and centred on. `g.CurrentTabBar` stands throughout
+//   the submission of every item, which is when both the shape and the label are drawn, and the rect was
+//   stamped on it at layout. The fallback is the item's own box, which a tab-bar button cannot reach.
+static ImRect SlateStripFor(const ImRect& fallback)
+{
+    ImGuiContext& g = *GImGui;
+
+    if (g.CurrentTabBar != NULL && g.CurrentTabBar->SlateStripRect.GetHeight() > 0.0f)
+        return g.CurrentTabBar->SlateStripRect;
+
+    return fallback;
+}
+
+static SlateButtonMetric SlateTabButtonMetric(float bar_across = 0.0f)
+{
+    ImGuiContext& g = *GImGui;
+
+    SlateButtonMetric m;
+
+    // \U0001f534 The bar's OWN height when one is offered. A docked node builds its rect itself and does not
+    //   pass through BeginTabBar's TabHeight override, so its bar is shorter than Style.TabHeight -- a
+    //   disc sized on the style figure then stood taller than the strip and bled onto the workspace.
+    m.Across   = (bar_across > 0.0f) ? bar_across
+               : (g.Style.TabHeight > 0.0f) ? g.Style.TabHeight
+               : (g.FontSize + g.Style.FramePadding.y * 2.0f);
