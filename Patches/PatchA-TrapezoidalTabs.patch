+// [SLATE PATCH A] Trapezoidal tab silhouette, transcribed from References/DockWorkspace.html.
+//   tabPath(w,h): slant = min(14, w * 0.16); the outline is [0,h] [slant,0] [w-slant,0] [w,h],
+//   with the two upper corners rounded at radius 5 and the two lower corners left square.
+//   The sheet rounds a corner by insetting along both incident edges and joining the two inset
+//   points with a quadratic through the corner itself -- its roundedPath() -- which is exactly
+//   PathBezierQuadraticCurveTo, so the curve is the browser's and not an approximation of it.
+//   The slant is read from Style.TabSlant in display pixels so ScaleAllSizes carries it; a slant
+//   fixed at 14 would be half as steep on a 2x display.
+//   Hit-testing is untouched: ItemAdd() and every drag path use the rectangular bb, precisely as
+//   the sheet's SVG is pointer-events:none over a rectangular <div>.
+static void SlateTabOutline(ImDrawList* draw_list, const ImRect& bb, float slant, float rounding, float y1, float y2, float inset)
+{
+    const ImVec2 corner[4] = {
+        ImVec2(bb.Min.x + inset,         y2),      // lower leading, square
+        ImVec2(bb.Min.x + slant + inset, y1),      // upper leading, rounded
+        ImVec2(bb.Max.x - slant - inset, y1),      // upper trailing, rounded
+        ImVec2(bb.Max.x - inset,         y2),      // lower trailing, square
+    };
+    const float radius[4] = { 0.0f, rounding, rounding, 0.0f };
+
+    for (int n = 0; n < 4; n++)
+    {
+        const ImVec2& p0 = corner[(n + 3) & 3];
+        const ImVec2& p  = corner[n];
+        const ImVec2& p1 = corner[(n + 1) & 3];
+
+        const ImVec2 d0 = ImVec2(p0.x - p.x, p0.y - p.y);
+        const ImVec2 d1 = ImVec2(p1.x - p.x, p1.y - p.y);
+        const float  l0 = ImSqrt(d0.x * d0.x + d0.y * d0.y);
+        const float  l1 = ImSqrt(d1.x * d1.x + d1.y * d1.y);
+
+        // The sheet clamps the radius to half of each incident edge, so a narrow tab degrades to a
+        // plain corner instead of folding its own outline inside out.
+        float r = radius[n];
+        if (l0 > 0.0f) r = ImMin(r, l0 * 0.5f);
+        if (l1 > 0.0f) r = ImMin(r, l1 * 0.5f);
+
+        if (r <= 0.1f || l0 <= 0.0f || l1 <= 0.0f)
+        {
+            draw_list->PathLineTo(p);
+            continue;
+        }
+
+        draw_list->PathLineTo(ImVec2(p.x + d0.x / l0 * r, p.y + d0.y / l0 * r));
+        draw_list->PathBezierQuadraticCurveTo(p, ImVec2(p.x + d1.x / l1 * r, p.y + d1.y / l1 * r));
+    }
+}
