{
  "name": "terrain-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Layer-based terrain and texturing editor in the Frontier Editor UI (dev-only browser build)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
