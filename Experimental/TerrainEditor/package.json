    "check:browser": "node scripts/CheckBrowser.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "puppeteer-core": "23.11.1",
    "vite": "^6.0.0"
  }
}
