      "channels": {
        "normal": {
          "label": "Tangent normal",
          "type": "normal",
          "group": "Normals",
          "description": "Projected high-surface normal in the low mesh UV tangent frame.",
          "colorSpace": "linear",
          "space": "tangent",
          "swatch": "normal",
          "normalConvention": "OpenGL +Y"
        },
        "world-normal": {
          "label": "World normal",
          "type": "vector",
          "group": "Normals",
          "description": "Projected high-surface normal in scene/world axes; XYZ is encoded from −1…1 to 0…1.",
          "colorSpace": "linear",
          "space": "world",
          "swatch": "normal-world"
        },
        "object-normal": {
          "label": "Object normal",
          "type": "vector",
          "group": "Normals",
          "description": "Projected normal in the low target's original local axes, undoing its imported world transform.",
          "colorSpace": "linear",
          "space": "object",
          "swatch": "normal-object"
        },
        "bent-normal": {
          "label": "Bent tangent normal",
          "type": "normal",
          "group": "Normals",
          "description": "Average unoccluded hemisphere direction in the low UV tangent frame; uses AO distance and samples.",
          "colorSpace": "linear",
          "space": "tangent",
          "swatch": "normal",
          "normalConvention": "OpenGL +Y"
        },
        "bent-world-normal": {
          "label": "Bent world normal",
          "type": "vector",
          "group": "Normals",
          "description": "Average unoccluded hemisphere direction in world axes.",
          "colorSpace": "linear",
          "space": "world",
          "swatch": "normal-world"
        },
        "bent-object-normal": {
          "label": "Bent object normal",
          "type": "vector",
          "group": "Normals",
          "description": "Average unoccluded hemisphere direction in the low target's original local axes.",
          "colorSpace": "linear",
          "space": "object",
          "swatch": "normal-object"
        },
        "bevel-normal": {
          "label": "Bevel normal",
          "type": "normal",
          "group": "Normals",
          "description": "Geometry-derived rounded-edge normal approximation in tangent space. Changes shading, not topology.",
          "colorSpace": "linear",
          "space": "tangent",
          "swatch": "normal",
          "derived": true,
          "normalConvention": "OpenGL +Y"
        },
        "occlusion": {
          "label": "Ambient occlusion",
          "type": "scalar",
          "group": "Surface",
          "description": "Hemisphere visibility against the high mesh: white exposed, black occluded.",
          "colorSpace": "linear",
          "swatch": "ao"
        },
        "occlusion-secondary": {
          "label": "Secondary AO",
          "type": "scalar",
          "group": "Surface",
          "description": "A second hemisphere-visibility bake with its own distance, useful for broader or finer occlusion.",
          "colorSpace": "linear",
          "swatch": "ao"
        },
        "curvature": {
          "label": "Curvature",
          "type": "scalar",
          "group": "Surface",
          "description": "Signed local normal variation estimate: 0.5 flat, brighter convex, darker concave.",
          "colorSpace": "linear",
          "swatch": "curvature"
        },
        "convexity": {
          "label": "Convexity",
          "type": "scalar",
          "group": "Surface",
          "description": "Positive signed curvature isolated as a bright-edge mask; controlled by curvature radius and mask strength.",
          "colorSpace": "linear",
          "swatch": "curvature"
        },
        "cavity": {
          "label": "Cavity / concavity",
          "type": "scalar",
          "group": "Surface",
          "description": "Negative signed curvature isolated as a bright-recess mask, not an alias of ambient occlusion.",
          "colorSpace": "linear",
          "swatch": "ao"
        },
        "thickness": {
          "label": "Thickness",
          "type": "scalar",
          "group": "Surface",
          "description": "Inward high-mesh ray distance divided by thickness range: white thicker, black thinner or no inward hit.",
          "colorSpace": "linear",
          "swatch": "height"
        },
        "height": {
          "label": "Projection height",
          "type": "scalar",
          "group": "Surface",
          "description": "Signed high-to-low distance along the low normal; 0.5 is zero, encoded using front/back range.",
          "colorSpace": "linear",
          "swatch": "height"
        },
        "vector-displacement": {
          "label": "Vector displacement",
          "type": "vector",
          "group": "Surface",
          "description": "Full projected high-minus-low XYZ offset in world axes; 0.5 per channel is zero. Not a multires sculpt solver.",
          "colorSpace": "linear",
          "space": "world",
          "swatch": "normal-object"
        },
        "position": {
          "label": "Position",
          "type": "vector",
          "group": "Coordinates & IDs",
          "description": "Projected high-surface XYZ normalized to the source world bounding box.",
          "colorSpace": "linear",
          "swatch": "position"
        },
        "id": {
          "label": "Object ID",
          "type": "color",
          "group": "Coordinates & IDs",
          "description": "24-bit source-object identity, encoded little-endian RGB; not a UV chart or material ID.",
          "colorSpace": "linear",
          "swatch": "id"
        },
        "uv-island": {
          "label": "UV island ID",
          "type": "color",
          "group": "Coordinates & IDs",
          "description": "A stable, distinct display color for each connected low UV chart. The manifest records the chart palette.",
          "colorSpace": "linear",
          "swatch": "id"
        },
        "uv": {
          "label": "UV coordinates",
          "type": "vector",
          "group": "Coordinates & IDs",
          "description": "Low target UV0 coordinates in R/G, blue = 1. Coordinates, not a UV-island ID.",
          "colorSpace": "linear",
          "swatch": "position"
        },
        "wireframe": {
          "label": "UV wireframe",
          "type": "scalar",
          "group": "Coordinates & IDs",
          "description": "Low triangle edges in texture space, using a pixel-width control. Includes internal triangle edges.",
          "colorSpace": "linear",
          "swatch": "wireframe"
        },
        "coverage": {
          "label": "UV coverage",
          "type": "scalar",
          "group": "Masks",
          "description": "White on covered low UV texels; transparent/black outside. Independent of high projection hits.",
          "colorSpace": "linear",
          "swatch": "coverage"
        },
        "alpha": {
          "label": "Alpha / hit mask",
          "type": "scalar",
          "group": "Masks",
          "description": "White where a high surface was projected, black for holes/misses. Does not transfer material transparency.",
          "colorSpace": "linear",
          "swatch": "coverage"
        },
        "bevel-mask": {
          "label": "Bevel mask",
          "type": "scalar",
          "group": "Masks",
          "description": "Angular change caused by rounded-edge normal averaging, isolated as a grayscale mask.",
          "colorSpace": "linear",
          "swatch": "curvature",
          "derived": true
        },
        "dust": {
          "label": "Dust mask",
          "type": "scalar",
          "group": "Masks",
          "description": "Derived upward-facing deposition mask, using world normal, chosen up axis, slope falloff and occlusion. Not a particle simulation.",
          "colorSpace": "linear",
          "swatch": "dust",
          "derived": true
        },
        "dirt": {
          "label": "Dirt mask",
          "type": "scalar",
          "group": "Masks",
          "description": "Derived occlusion plus concavity mask, useful for recesses and grime. No painted dirt texture is invented.",
          "colorSpace": "linear",
          "swatch": "ao",
          "derived": true
        },
        "edge-wear": {
          "label": "Edge wear mask",
          "type": "scalar",
          "group": "Masks",
          "description": "Derived convexity weighted by surface exposure, for exposed-edge masking; not simulated abrasion.",
          "colorSpace": "linear",
          "swatch": "curvature",
          "derived": true
        },
        "base-color": {
          "label": "Vertex color",
          "type": "color",
          "group": "Color",
          "description": "Interpolated high vertex color, converted from linear to sRGB for PNG. White if no vertex color exists; no material texture transfer.",
          "colorSpace": "sRGB",
          "swatch": "color"
        }
      }
    }
  ],
  "encodings": {
    "height": "distance = (sample - .5) * 2 * max(front,back)",
    "thickness": "sample * thicknessRange; distances beyond range saturate white, absent opposite hits stay black",
    "id": "24-bit little-endian RGB; source ID 1",
    "uvIslands": "see chartPalette"
  },
  "limitations": [
    "Utah teapot: 8-segment low, 24-segment high; 32 packed Bezier charts.",
    "RGBA PNGs are 8-bit. IDs and vertex-color outputs may legitimately be constant.",
    "Tangent normal Z < 0 identifies opposite-facing or strongly folded projections; inspect separately.",
    "Thickness is inward opposite-surface distance, not guaranteed wall thickness on an open or intersecting model."
  ]
}