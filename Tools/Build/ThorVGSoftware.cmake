# Reviewed ThorVG 1.0.0 software-only build. No graphics SDK is needed for this library.
# Dependency revision: 6715f99ac106b6d4587f384a78c59fe957cfd2a3.
find_package(Python3 REQUIRED COMPONENTS Interpreter)
if(NOT DEFINED FRONTIER_ROOT)
    set(FRONTIER_ROOT "${CMAKE_SOURCE_DIR}")
endif()
set(THORVG_SRC "${FRONTIER_ROOT}/ExternalPackages/thorvg")
set(THORVG_STAGING "${CMAKE_BINARY_DIR}/thorvg_icon_art")
file(MAKE_DIRECTORY "${THORVG_STAGING}")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${FRONTIER_ROOT}/Tools/Build/StageThorVG.py"
    "${THORVG_SRC}" "${THORVG_STAGING}/tvgInitializer.cpp" RESULT_VARIABLE THORVG_STAGED)
if(NOT THORVG_STAGED EQUAL 0)
    message(FATAL_ERROR "ThorVG must match the reviewed software-renderer revision")
endif()
file(WRITE "${THORVG_STAGING}/config.h" "#pragma once\n#define THORVG_VERSION_STRING \"1.0.0\"\n#define THORVG_SW_RASTER_SUPPORT 1\n#define THORVG_SVG_LOADER_SUPPORT 1\n#define THORVG_THREAD_SUPPORT 1\n#define THORVG_FILE_IO_SUPPORT 1\n")
set(THORVG_INCLUDES "${THORVG_SRC}/inc" "${THORVG_STAGING}")
set(THORVG_SOURCES "${THORVG_STAGING}/tvgInitializer.cpp")
foreach(DIRECTORY src/common src/renderer src/renderer/sw_engine src/loaders/svg src/loaders/raw)
    list(APPEND THORVG_INCLUDES "${THORVG_SRC}/${DIRECTORY}")
    file(GLOB THORVG_PART CONFIGURE_DEPENDS "${THORVG_SRC}/${DIRECTORY}/*.cpp")
    list(REMOVE_ITEM THORVG_PART "${THORVG_SRC}/src/renderer/tvgInitializer.cpp")
    list(APPEND THORVG_SOURCES ${THORVG_PART})
endforeach()
add_library(thorvg_static STATIC ${THORVG_SOURCES})
target_include_directories(thorvg_static PUBLIC ${THORVG_INCLUDES})
target_compile_definitions(thorvg_static PUBLIC TVG_STATIC PRIVATE TVG_BUILD NOMINMAX)
set_target_properties(thorvg_static PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_compile_features(thorvg_static PUBLIC cxx_std_14)
find_package(Threads REQUIRED)
target_link_libraries(thorvg_static PUBLIC Threads::Threads)
