+.card .glow{position:absolute;inset:-40%;z-index:-2;background:radial-gradient(38% 46% at 68% 40%,#6f9bff 0%,#1f5eff 22%,rgba(26,79,224,.85) 42%,transparent 68%),radial-gradient(34% 44% at 22% 82%,rgba(31,94,255,.9),transparent 62%),radial-gradient(60% 60% at 50% 50%,#0a2a9a,transparent 74%);filter:blur(16px);animation:drift 16s ease-in-out infinite alternate}
