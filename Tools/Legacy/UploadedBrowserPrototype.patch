+    const taken = live ? Math.max(3, Math.floor(spots * .75)) : Math.min(spots, 2 + Math.floor(rnd() * spots));
+    const [lo, hi] = REGIONS[region], ping = lo + Math.floor(rnd() * (hi - lo));
+    const pool = HOSTS.filter(h => h !== host).sort(() => rnd() - .5);
+    const mem = nm => ({ name: nm, ready: live || rnd() < .6, car: pick(rnd, CARS), ping: Math.max(8, ping + Math.floor(rnd() * 30) - 15), voice: pick(rnd, ['on','on','on','on','muted','off']) });
+    const members = [{ ...mem(host), host: true, ready: true }, ...pool.slice(0, taken - 1).map(mem)];
