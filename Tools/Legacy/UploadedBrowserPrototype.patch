diff --git a/app/index.html b/app/index.html
new file mode 100644
index 0000000..bc3e862
--- /dev/null
+++ b/app/index.html
@@ -0,0 +1,1214 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8" />
+<meta name="viewport" content="width=device-width, initial-scale=1" />
+<meta name="color-scheme" content="dark" />
+<title>FRONTIER · Lobby</title>
+<link rel="preload" href="fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
+<style>
+@font-face{font-family:'Inter';font-style:normal;font-weight:100 900;font-display:swap;src:url(fonts/inter-latin-wght-normal.woff2) format('woff2')}
+
+/* ============================================================
+   TOKENS  (palette: blue · black · white · dark grey)
+   ============================================================ */
+:root{
+  --blue:#1f5eff; --blue-soft:#4d80ff; --blue-deep:#1a4fe0;
+  --bg:#0a0a0a; --panel:#121212; --inset:#1a1a1a; --field:#000; --raised:#222; --selected:#1c1c1c; --row:#161616;
+  --stroke:rgba(255,255,255,.06); --stroke-strong:#2e2e2e;
+  --text:#fff; --dim:#8a8a8a; --faint:#5c5c5c;
+  --font:'Inter',system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
+  --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
+  --ease:cubic-bezier(.22,.61,.36,1);
+  --shadow-pop:0 24px 60px rgba(0,0,0,.75);
+  --r-pill:999px;
+}
+*{box-sizing:border-box;margin:0;padding:0}
+html,body{height:100%}
+body{background:var(--blue);font-family:var(--font);color:var(--text);-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;overflow:hidden;font-feature-settings:"cv11","ss01"}
+button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
+input{font:inherit;color:inherit}
+svg{display:block}
+.ic{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}
+:focus-visible{outline:2px solid #fff;outline-offset:2px;border-radius:6px}
+@keyframes rowIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
+@keyframes menuIn{from{opacity:0;transform:translateY(-4px)}}
+@keyframes pop{from{opacity:0;transform:scale(.85)}}
+@keyframes spin{to{transform:rotate(360deg)}}
+@keyframes pulse{0%,100%{box-shadow:0 0 0 0 rgba(31,94,255,.55)}70%{box-shadow:0 0 0 6px rgba(31,94,255,0)}}
+@keyframes pulseW{0%,100%{box-shadow:0 0 0 0 rgba(255,255,255,.5)}70%{box-shadow:0 0 0 6px rgba(255,255,255,0)}}
+@keyframes blink{0%,80%,100%{opacity:.3;transform:translateY(0)}40%{opacity:1;transform:translateY(-2px)}}
+
+/* ============================================================
+   STAGE / DEVICE
+   ============================================================ */
+.stage{position:fixed;inset:0;display:grid;place-items:center;padding:4vh 4vw}
+.device{position:relative;width:min(1180px,100%,calc((100vh - 8vh) * 1.5));aspect-ratio:4/3;border-radius:38px;background:#111;padding:14px;box-shadow:0 60px 120px -30px rgba(0,0,0,.6),0 0 0 1px rgba(255,255,255,.08),inset 0 0 0 2px #2b2b2b}
+.device::before,.device::after{content:"";position:absolute;left:-3px;width:3px;height:9%;border-radius:2px 0 0 2px;background:#1b1b1b}
+.device::before{top:18%}.device::after{top:31%}
+.screen{position:relative;width:100%;height:100%;border-radius:26px;background:var(--bg);overflow:hidden}
+.ui{position:absolute;inset:0;width:1000px;height:750px;transform-origin:0 0;transform:scale(var(--s,1));overflow:hidden;display:flex;flex-direction:column}
+
+/* mode swap */
+.hero-body,.left,.right{transition:opacity .16s,transform .22s var(--ease)}
+.ui.swapping .hero-body,.ui.swapping .left,.ui.swapping .right{opacity:0;transform:translateY(6px)}
+
+/* ============================================================
+   HERO
+   ============================================================ */
+.hero{position:relative;flex:none;height:196px;background:var(--blue);padding:20px 24px 18px;display:flex;flex-direction:column}
+.nav{display:flex;align-items:center;gap:14px;height:32px}
+.logo{height:32px;padding:0 14px;border-radius:16px;background:#fff;color:var(--blue);font-weight:800;font-size:12px;letter-spacing:.14em;display:flex;align-items:center}
+.tabs{height:32px;padding:3px;border-radius:16px;background:rgba(255,255,255,.14);display:flex;align-items:center;gap:2px;position:relative}
+.tab{position:relative;height:26px;padding:0 14px;border-radius:13px;font-size:12px;font-weight:500;color:#fff;white-space:nowrap;z-index:1;transition:color .2s;display:inline-flex;align-items:center;text-decoration:none}
+.tab.is-on{color:var(--blue)}
+.tab-ink{position:absolute;top:3px;height:26px;border-radius:13px;background:#fff;transition:left .35s var(--ease),width .35s var(--ease)}
+.hero-body{flex:1;display:flex;align-items:flex-end;justify-content:space-between;gap:16px;min-width:0}
+.hero-left{min-width:0;display:flex;flex-direction:column;gap:10px}
+.crumb{display:none;align-items:center;gap:6px;height:26px;padding:0 11px 0 7px;border-radius:13px;background:rgba(255,255,255,.14);font-size:11px;font-weight:500;width:max-content;color:#fff;transition:background .15s}
+.crumb:hover{background:rgba(255,255,255,.24)}
+.crumb .ic{width:12px;height:12px}
+.hero h1{font-size:72px;font-weight:400;letter-spacing:-.045em;line-height:.85;margin-bottom:-6px;white-space:nowrap}
+.hero h1.sm{font-size:50px;letter-spacing:-.035em;line-height:.95;margin-bottom:-2px;max-width:620px;overflow:hidden;text-overflow:ellipsis}
+.hero-actions{display:flex;gap:8px;align-items:center;flex:none}
+.hbtn{height:32px;padding:0 6px 0 14px;border-radius:16px;background:#fff;color:#111;font-size:12px;font-weight:500;display:inline-flex;align-items:center;gap:8px;transition:transform .2s var(--ease),box-shadow .2s;white-space:nowrap;max-width:300px}
+.hbtn i{width:22px;height:22px;border-radius:50%;background:var(--blue);color:#fff;display:grid;place-items:center;flex:none}
+.hbtn i .ic{width:12px;height:12px;stroke-width:2.5}
+.hbtn em{width:8px;height:8px;border-radius:50%;background:var(--blue);flex:none;animation:pulse 1.6s infinite}
+.hbtn span{overflow:hidden;text-overflow:ellipsis}
+.hbtn:hover{transform:translateY(-1px);box-shadow:0 8px 20px -8px rgba(0,0,0,.5)}
+.hbtn:active{transform:none}
+
+/* ============================================================
+   CONTENT
+   ============================================================ */
+.content{flex:1;min-height:0;display:grid;grid-template-columns:1fr;gap:16px;padding:16px 24px 18px}
+[data-mode="room"] .content{grid-template-columns:1fr 316px}
+.left,.right{min-width:0;min-height:0;display:flex;flex-direction:column}
+.right{display:none}
+[data-mode="room"] .right{display:flex}
+.browse{flex:1;min-height:0;display:flex;flex-direction:column}
+[data-mode="room"] .browse{display:none}
+.room{display:none}
+[data-mode="room"] .room{display:flex;flex-direction:column;gap:10px;min-height:0;flex:1}
+
+/* --- toolbar: search · filter (Slate pill fields) --- */
+.toolbar{display:flex;align-items:center;gap:8px;position:relative;z-index:30}
+.field{height:32px;border-radius:var(--r-pill);background:var(--field);border:1px solid var(--stroke);display:flex;align-items:center;gap:8px;padding:0 12px;min-width:0;transition:border-color .15s}
+.field:focus-within{border-color:var(--stroke-strong)}
+.field .ic{color:var(--faint)}
+.field input{flex:1;min-width:0;background:transparent;border:0;outline:0;font-size:12px}
+.field input::placeholder{color:var(--faint)}
+.field kbd{font:600 9.5px/1 var(--font);color:var(--faint);border:1px solid var(--stroke-strong);border-radius:5px;padding:3px 5px}
+.field:focus-within kbd,.field.has kbd{display:none}
+.search{width:360px;flex:none}
+.count{margin-left:auto;font-size:10px;color:var(--faint);white-space:nowrap}
+.count b{font-weight:600;color:var(--dim)}
+.count .eos{margin-left:10px}
+
+.dd{position:relative;flex:none}
+.dd-btn{display:flex;align-items:stretch;height:32px;border-radius:var(--r-pill);overflow:hidden;border:1px solid var(--stroke);width:100%;text-align:left}
+.dd-btn .cur{flex:1;background:var(--field);display:flex;align-items:center;gap:8px;padding:0 12px;font-size:12px;font-weight:500;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.dd-btn .caret{width:32px;background:var(--inset);border-left:1px solid var(--stroke);display:grid;place-items:center;color:var(--dim);transition:background .15s}
+.dd-btn:hover .caret{background:var(--raised)}
+.dd-btn .caret .ic{transition:transform .2s var(--ease)}
+.open>.dd-btn .caret .ic{transform:rotate(180deg)}
+.dd-menu{position:absolute;top:calc(100% + 6px);left:0;min-width:100%;z-index:40;background:var(--field);border:1px solid var(--stroke-strong);border-radius:16px;padding:5px;display:none;flex-direction:column;gap:2px;box-shadow:var(--shadow-pop)}
+.open>.dd-menu{display:flex;animation:menuIn .18s var(--ease)}
+.opt{padding:7px 12px;border-radius:var(--r-pill);color:var(--dim);font-size:12px;font-weight:500;text-align:left;white-space:nowrap;transition:background .12s,color .12s}
+.opt:hover{background:#141414;color:#fff}
+.opt.sel{color:#fff;background:#181818}
+
+/* filter = dropdown whose options become chips */
+.filter{position:relative;flex:none}
+.filter .cur .ic{color:var(--dim)}
+.fcount{min-width:16px;height:16px;padding:0 5px;border-radius:8px;background:var(--blue);color:#fff;font-size:9.5px;font-weight:700;display:grid;place-items:center}
+.fcount:empty{display:none}
+.fmenu{position:absolute;top:calc(100% + 6px);left:0;width:250px;z-index:40;background:var(--field);border:1px solid var(--stroke-strong);border-radius:16px;padding:6px;display:none;box-shadow:var(--shadow-pop);max-height:400px;overflow:auto;scrollbar-width:none}
+.open>.fmenu{display:block;animation:menuIn .18s var(--ease)}
+.fsec+.fsec{margin-top:4px;padding-top:4px;border-top:1px solid var(--stroke)}
+.fsec-h{font-size:9.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--faint);padding:7px 12px 4px}
+.fopt{display:flex;align-items:center;justify-content:space-between;width:100%;padding:7px 10px 7px 12px;border-radius:var(--r-pill);color:var(--dim);font-size:12px;font-weight:500;transition:background .12s,color .12s}
+.fopt .ic{width:12px;height:12px;color:var(--faint)}
+.fopt:hover{background:#141414;color:#fff}
+.fopt:hover .ic{color:#fff}
+.fempty{padding:14px 12px;font-size:12px;color:var(--faint);text-align:center}
+
+/* chips */
+.chips{display:flex;flex-wrap:wrap;align-items:center;gap:6px;max-height:0;opacity:0;overflow:hidden;transition:max-height .3s var(--ease),opacity .25s,margin .3s var(--ease)}
+.chips.has{max-height:80px;opacity:1;margin-top:10px}
+.chip{height:26px;padding:0 4px 0 10px;border-radius:13px;background:var(--inset);border:1px solid var(--stroke);display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:500;color:#fff}
+.chip.new{animation:pop .25s var(--ease)}
+.chip .g{color:var(--faint);font-weight:500}
+.chip .x{width:18px;height:18px;border-radius:50%;display:grid;place-items:center;color:var(--dim);transition:background .12s,color .12s}
+.chip .x .ic{width:10px;height:10px;stroke-width:2.5}
+.chip .x:hover{background:var(--raised);color:#fff}
+.clear{height:26px;padding:0 8px;font-size:11px;font-weight:500;color:var(--dim);border-radius:13px;transition:color .12s,background .12s}
+.clear:hover{color:#fff;background:var(--inset)}
+
+/* list — square rows */
+.cols,.row{display:grid;grid-template-columns:22px minmax(0,1fr) 112px 82px 76px 108px 62px 46px 46px 74px;gap:10px;align-items:center;padding:0 12px}
+.cols{margin-top:12px;padding-top:6px;padding-bottom:7px;font-size:9.5px;color:var(--faint);letter-spacing:.02em;border-bottom:1px solid var(--stroke)}
+.rows{flex:1;min-height:0;overflow:auto;display:flex;flex-direction:column;gap:1px;padding-top:1px;scrollbar-width:none}
+.rows::-webkit-scrollbar{display:none}
+.row{position:relative;height:42px;background:var(--row);font-size:10px;color:var(--dim);cursor:pointer;transition:background .15s;animation:rowIn .45s var(--ease) both;animation-delay:calc(var(--i) * 30ms);flex:none}
+.row:hover{background:var(--selected)}
+.row.is-sel{background:var(--selected)}
+.row .bar{position:absolute;left:0;top:0;bottom:0;width:3px;background:transparent;transition:background .15s}
+.row.is-sel .bar{background:var(--blue)}
+.row .n{font-size:10px;color:#fff;font-weight:500;text-align:center}
+.row .who{display:flex;align-items:center;gap:8px;min-width:0}
+.dot{width:20px;height:20px;border-radius:50%;flex:none;display:grid;place-items:center;font-size:7.5px;font-weight:700;letter-spacing:.02em}
+.row .name{min-width:0;display:flex;flex-direction:column;gap:2px}
+.row .name b{font-size:11px;font-weight:500;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.row .name small{font-size:9px;color:var(--faint);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.row .name small u{text-decoration:none;color:var(--blue-soft);font-weight:600}
+.row .track{color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.badge{display:inline-block;font-style:normal;border:1px solid var(--stroke-strong);border-radius:9px;padding:2px 7px;font-size:9px;font-weight:600;letter-spacing:.03em;color:var(--dim);white-space:nowrap}
+.acc{display:inline-flex;align-items:center;gap:5px;font-size:10px;color:var(--dim);white-space:nowrap}
+.acc .ic{width:11px;height:11px}
+.acc.prv{color:#fff}
+.st{display:inline-flex;align-items:center;gap:6px;font-size:10px;color:var(--dim);white-space:nowrap}
+.st i{width:6px;height:6px;border-radius:50%;background:var(--faint);flex:none}
+.st.open i{background:var(--blue)}
+.st.soon,.st.starting,.st.live{color:#fff}
+.st.soon i,.st.starting i{background:var(--blue);animation:pulse 1.6s infinite}
+.st.live i{background:#fff;animation:pulseW 1.6s infinite}
+.st.full{color:var(--faint)}
+.row .num{font-variant-numeric:tabular-nums}
+.row .soon{color:#fff}
+.row.is-dim .track,.row.is-dim .name b{color:var(--dim)}
+.row .lock{display:inline-flex;vertical-align:-2px;margin-left:4px;color:var(--faint)}
+.row .lock .ic{width:10px;height:10px}
+.play{height:24px;padding:0 12px;border-radius:12px;background:var(--blue);color:#fff;font-size:9.5px;font-weight:600;justify-self:end;white-space:nowrap;transition:transform .2s var(--ease),background .2s,box-shadow .2s;position:relative;display:inline-flex;align-items:center;gap:5px}
+.play .ic{width:11px;height:11px}
+.play:hover{background:var(--blue-soft);transform:translateY(-1px);box-shadow:0 6px 16px -6px rgba(31,94,255,.8)}
+.play:active{transform:scale(.96)}
+.play:disabled{background:var(--raised);color:var(--faint);cursor:default;transform:none;box-shadow:none}
+.play.in{background:#fff;color:#111}
+.play.in:hover{background:#e6e6e6;box-shadow:none}
+.play.spec{background:transparent;border:1px solid var(--stroke-strong);color:var(--dim)}
+.play.spec:hover{color:#fff;border-color:var(--dim);box-shadow:none;transform:none}
+.loading{color:transparent!important;pointer-events:none}
+.loading::after{content:"";position:absolute;left:50%;top:50%;width:10px;height:10px;margin:-5px 0 0 -5px;border:1.5px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite}
+.empty{padding:40px 20px;text-align:center;color:var(--faint);font-size:12px;display:flex;flex-direction:column;gap:8px;align-items:center}
+.empty .ic{width:22px;height:22px;stroke-width:1.5}
+.empty button{color:var(--dim);font-size:11.5px;font-weight:500;text-decoration:underline;text-underline-offset:3px}
+.empty button:hover{color:#fff}
+
+/* ============================================================
+   BUTTONS / PANELS
+   ============================================================ */
+.btn{height:34px;padding:0 16px;border-radius:var(--r-pill);border:1px solid var(--stroke);background:var(--inset);color:#fff;font-size:12px;font-weight:500;display:inline-flex;align-items:center;justify-content:center;gap:8px;transition:background .15s,transform .12s var(--ease),color .15s;position:relative;white-space:nowrap}
+.btn:hover{background:var(--raised)}
+.btn:active{transform:scale(.97)}
+.btn.primary{background:var(--blue);border-color:transparent;font-weight:600;box-shadow:0 8px 24px -8px rgba(31,94,255,.6)}
+.btn.primary:hover{background:var(--blue-soft)}
+.btn.white{background:#fff;color:#111;border-color:transparent;font-weight:600}
+.btn.white:hover{background:#e6e6e6}
+.btn.ghost{background:transparent;border-color:transparent;color:var(--dim)}
+.btn.ghost:hover{background:var(--inset);color:#fff}
+.btn.icon{width:34px;padding:0}
+.btn.sm{height:30px;width:30px}
+.btn.wide{flex:1}
+.btn[disabled]{opacity:.45;pointer-events:none}
+.btn.white[disabled]{opacity:1;background:#fff;color:#111}
+.eos{font-size:9.5px;color:var(--faint);letter-spacing:.01em;font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.panel{background:var(--panel);border:1px solid var(--stroke);border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.03);display:flex;flex-direction:column;overflow:hidden}
+.right>.panel{flex:1;min-height:0}
+
+/* ============================================================
+   ROOM · header (unchanged) · roster squares · chat
