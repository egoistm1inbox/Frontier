+};
+function checkStart(){
+  const l = byId(state.joined); if (!l || state.phase !== 'wait' || l.host === 'You') return;
+  if (l.members.length >= 2 && l.members.every(m => m.ready)) startCountdown();
+}
+function startCountdown(){
+  state.phase = 'count'; state.countdown = 10;
+  sys('All drivers ready · <b>starting in 10 s</b>', 'EOS_Lobby_UpdateLobby · STATE=COUNTDOWN');
+  Chat.event(CHAT.onCountdown, true);
+  renderStatus(); if (state.mode === 'browse') refreshRow(state.joined);
+}
+function toggleReady(){
+  const l = byId(state.joined); if (!l || state.phase === 'live') return;
+  const me = l.members.find(m => m.you); if (!me) return;
+  if (l.host === 'You'){ if (state.phase === 'wait' && l.members.length >= 2 && l.members.every(m => m.ready)) startCountdown(); return; }
+  if (state.phase === 'count'){ state.phase = 'wait'; state.countdown = 0; me.ready = state.ready = false; sys(`<b>${esc(ME.display)}</b> cancelled the countdown`, 'STATE=WAITING'); }
+  else { me.ready = state.ready = !state.ready; sys(`<b>${esc(ME.display)}</b> is ${state.ready ? 'ready' : 'not ready'}`, 'EOS_Lobby_UpdateLobbyModification · READY'); if (state.ready && Math.random() < .7) Chat.event(CHAT.onReady); }
+  renderRoomHead(); renderRoster(false); renderStatus(); checkStart();
+}
+
+/* ============================================================
+   TICKET (boarding-pass style)
+   ============================================================ */
+function boxPerm(l){ const rnd = seed('boxes-' + l.id); const a = Array.from({ length: l.spots }, (_, i) => i); for (let i = a.length - 1; i > 0; i--){ const j = Math.floor(rnd() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; }
+function takenBoxes(l){ const perm = boxPerm(l), m = new Map(); l.members.filter(x => !x.you).forEach((x, i) => m.set(perm[i % perm.length], x)); return m; }
+function myBox(l){ const taken = takenBoxes(l); if (state.box != null && !taken.has(state.box) && state.box < l.spots) return state.box; for (let i = 0; i < l.spots; i++) if (!taken.has(i)) return (state.box = i); return 0; }
+const boxLabel = i => `${Math.floor(i / 4) + 1}${'ABCD'[i % 4]}`;
+function boxesHTML(l, mine){
+  const taken = takenBoxes(l), rows = Math.ceil(l.spots / 4);
+  let h = `<span></span><span class="hd">A</span><span class="hd">B</span><span></span><span class="hd">C</span><span class="hd">D</span>`;
+  for (let r = 0; r < rows; r++){
+    h += `<span class="hd">${r + 1}</span>`;
+    for (let c = 0; c < 4; c++){
+      if (c === 2) h += `<span></span>`;
+      const i = r * 4 + c;
+      if (i >= l.spots){ h += `<span></span>`; continue; }
+      const t = taken.get(i);
+      h += `<button type="button" class="box ${t ? 'tk' : ''} ${i === mine ? 'me' : ''}" data-i="${i}" title="Box ${boxLabel(i)}${t ? ' · ' + esc(t.name) : ''}" ${t ? 'disabled' : ''}></button>`;
+    }
+  }
+  return h;
+}
+function barcode(id){
+  const rnd = seed('bar-' + id); let x = 0, bars = '';
+  while (x < 296){ const w = 1 + Math.floor(rnd() * 3), g = 1 + Math.floor(rnd() * 2); bars += `<rect x="${x}" y="0" width="${w}" height="40" fill="#fff"/>`; x += w + g; }
+  return `<svg viewBox="0 0 300 40" preserveAspectRatio="none">${bars}</svg>`;
+}
+function footHTML(l){
+  const host = l.host === 'You', all = l.members.length >= 2 && l.members.every(m => m.ready);
+  let btn, note;
+  if (state.phase === 'live'){ btn = `<button class="btn wide" disabled>Session live</button>`; note = 'EOS_Sessions_StartSession · presence updated'; }
+  else if (state.phase === 'count'){ btn = host ? `<button class="btn white wide" disabled>Starting in 0:${pad2(state.countdown)}</button>` : `<button class="btn white wide" id="btnReady" type="button">Starting in 0:${pad2(state.countdown)} · cancel</button>`; note = 'EOS_Lobby_UpdateLobby · STATE=COUNTDOWN'; }
+  else if (host){ btn = `<button class="btn ${all ? 'white' : 'primary'} wide" id="btnReady" type="button" ${all ? '' : 'disabled'}>Start race</button>`; note = all ? 'All drivers ready · you can start' : l.members.length < 2 ? 'Waiting for drivers to join' : 'Waiting for all drivers to ready up'; }
+  else { btn = `<button class="btn ${state.ready ? 'white' : 'primary'} wide" id="btnReady" type="button">${state.ready ? `${IC.check} Ready` : 'Ready up'}</button>`; note = state.ready ? 'Race starts when all drivers are ready' : 'Ready up to lock your pit box'; }
+  return `${btn}<span class="eos">${note}</span>`;
+}
+function renderTicket(){
+  const l = byId(state.joined); if (!l) return;
+  const t = trackOf(l.track), q = SESSION[l.type], mine = myBox(l);
+  const start = new Date(Date.now() + Math.max(0, l.startsIn) * 60000), raceAt = new Date(start.getTime() + q.aDur * 60000);
+  const code = (l.eosId.slice(0, 4) + '-' + l.eosId.slice(4, 8)).toUpperCase();
+  $('#ticket').innerHTML = `
+    <div class="tk-scroll">
+      <div class="tk-card">
+        <div class="tk-air"><span class="tk-logo"><svg viewBox="0 0 36 36" width="36" height="36"><text x="18" y="18" text-anchor="middle" dominant-baseline="central" fill="#fff" font-family="Inter,system-ui,sans-serif" font-weight="800" font-size="12" letter-spacing="0.5">${seriesCode(l.series)}</text></svg></span><div><b>${l.series}</b><span>${code} · ${l.type} · ${isPublic(l) ? 'Public' : 'Private'}${l.ranked ? ' · Ranked' : ''}</span></div></div>
+        <div class="tk-route">
+          <div class="tk-end"><small>${fmtTime(start)}</small><b>${q.a}</b><span>${q.aDur} min</span></div>
+          <div class="tk-mid"><small>${t.code} · ${t.km} km</small><div class="tk-line"><i>${IC.flag}</i></div><small>${esc(l.track)}</small></div>
+          <div class="tk-end r"><small>${fmtTime(raceAt)}</small><b>${q.b}</b><span>${q.bLabel(l.laps)}</span></div>
+        </div>
+        <div class="tk-grid">
+          <div><small>Driver</small><b>${esc(ME.display)}</b></div>
+          <div><small>Lobby code</small><b>${code}</b></div>
+          <div><small>Pit box</small><b>${boxLabel(mine)}</b></div>
+          <div><small>Car</small><b>${ME.car}</b></div>
+          <div><small>Region</small><b>${l.region} · ${l.ping} ms</b></div>
+          <div><small>Entry</small><b>${l.entry}</b></div>
+        </div>
+        <div class="tk-code">${barcode(l.eosId)}<span>LobbyId ${l.eosId} · JoinLobbyById</span></div>
+      </div>
+      <div class="tk-card">
+        <div class="pb-head"><b>Pit boxes</b><span>${esc(l.track)} · Box ${boxLabel(mine)} is yours · tap to change</span></div>
+        <div class="legend"><span><i></i>Available</span><span><i class="tk"></i>Taken</span><span><i class="me"></i>Yours</span></div>
+        <div class="boxes" id="boxes">${boxesHTML(l, mine)}</div>
+      </div>
+    </div>
+    <div class="tk-foot">${footHTML(l)}</div>`;
+}
+$('#ticket').addEventListener('click', e => {
+  const b = e.target.closest('.box');
+  if (b && !b.disabled){ state.box = +b.dataset.i; renderTicket(); toast(`Pit box ${boxLabel(state.box)}`, 'EOS_Lobby_UpdateLobbyModification · PIT_BOX'); return; }
+  if (e.target.closest('#btnReady')) toggleReady();
+});
+
+/* ============================================================
+   CREATE LOBBY (modal)
+   ============================================================ */
+const modal = $('#modal');
+const slug = s => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
+const form = {
+  track: dropdown($('#mTrack'), { options: TRACKS.map(t => ({ value: t.n, label: `${t.n} · ${t.c}` })), value: 'Kyalami', onChange: bucket }),
+  perm: dropdown($('#mPerm'), { options: [{ value:'Open', label:'Public · advertised in search' }, { value:'Friends', label:'Private · friends via presence' }, { value:'Invite only', label:'Private · invite only' }], value: 'Open' }),
+  entry: dropdown($('#mEntry'), { options: ['Free','5 CR','10 CR','25 CR'].map(v => ({ value: v, label: v })), value: 'Free' }),
+  type: () => $('#mType .active').textContent,
+  laps: () => +$('#mLaps .v').textContent,
+  max: () => +$('#mMax .v').textContent,
+  opts: () => Object.fromEntries($$('#mOpts .sw').map(s => [s.dataset.k, s.dataset.on === 'true'])),
+};
+function bucket(){ $('#mBucket').value = `${slug(form.type())}:${slug(form.track.value)}:s3`; }
+$('#mType').addEventListener('click', e => { const b = e.target.closest('button'); if (!b) return; $$('#mType button').forEach(x => x.classList.toggle('active', x === b)); const t = b.textContent; $('#mLaps .v').textContent = t === 'Sprint' ? 5 : t === 'Endurance' ? 25 : t === 'Drift' ? 3 : 1; bucket(); });
+$$('.stepper').forEach(s => s.addEventListener('click', e => { const b = e.target.closest('button'); if (!b) return; const v = $('.v', s); v.textContent = Math.min(+s.dataset.max, Math.max(+s.dataset.min, +v.textContent + +b.dataset.d)); }));
+$('#mOpts').addEventListener('click', e => { const s = e.target.closest('.sw'); if (!s) return; const on = s.dataset.on !== 'true'; s.dataset.on = on; s.setAttribute('aria-checked', on); });
+
+let lastFocus = null;
+function openModal(){ lastFocus = document.activeElement; closeMenus(); modal.classList.add('open'); modal.setAttribute('aria-hidden', 'false'); setTimeout(() => { $('#mName').focus(); $('#mName').select(); }, 80); }
+function closeModal(){ modal.classList.remove('open'); modal.setAttribute('aria-hidden', 'true'); closeMenus(); lastFocus?.focus?.(); }
