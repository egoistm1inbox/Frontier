+$('#mCancel').addEventListener('click', closeModal);
+modal.addEventListener('pointerdown', e => { if (e.target === modal) closeModal(); });
+$('#mCreate').addEventListener('click', async e => {
+  const b = e.currentTarget; b.classList.add('loading'); $('#mEos').textContent = 'EOS_Lobby_CreateLobby · waiting for callback…';
