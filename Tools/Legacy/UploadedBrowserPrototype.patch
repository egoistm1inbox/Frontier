+
+function makeLobbies(n){
+  const rnd = seed('frontier-lobbies-v5');
+  const list = [];
+  for (let i = 0; i < n; i++){
+    const type = i % 4 === 0 ? 'Sprint' : pick(rnd, TYPES);
+    const series = type === 'Sprint' ? (rnd() < .7 ? 'Sprint Series' : 'FRONTIER Open') : type === 'Endurance' ? 'Endurance Cup' : 'FRONTIER Open';
+    const track = pick(rnd, TRACKS), region = pick(rnd, ['ZA','ZA','EU','NA','AP']);
+    const host = HOSTS[i % HOSTS.length], spots = pick(rnd, [8,8,8,10,12,16]);
