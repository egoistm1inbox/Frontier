+.card::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(0,0,0,.05),rgba(0,0,0,.45))}
+.card-top{display:flex;justify-content:space-between;align-items:flex-start}
+.card-top small{font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.72);font-weight:600}
+.sym{height:24px;padding:0 10px 0 6px;border-radius:12px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.14);font-size:10px;font-weight:700;letter-spacing:.08em;display:inline-flex;align-items:center;gap:6px}
+.sym i{width:14px;height:14px;border-radius:50%;background:#fff;color:var(--blue);font-size:7px;font-style:normal;display:grid;place-items:center}
+.card .amt{margin-top:auto;font-size:36px;font-weight:500;letter-spacing:-.035em;line-height:1;font-variant-numeric:tabular-nums;display:flex;align-items:baseline;gap:8px}
